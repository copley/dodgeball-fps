; Engine configuration file.
; Multiplayer product branch entry point.

config_version=5

[application]

config/name="dodgeball-fps-2v2"
run/main_scene="res://scenes/multiplayer_main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[input]

move_forward={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
move_back={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
move_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
move_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
pickup_ball={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
throw_ball={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":1)]
}
catch_ball={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":2)]
}
sprint={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
crouch={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194326)]
}
jump={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
dodge_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":81)]
}
dodge_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":70)]
}
restart_round={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":82)]
}
pause_menu={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}
toggle_performance={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194334)]
}

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
scaling_3d/scale=1.0
